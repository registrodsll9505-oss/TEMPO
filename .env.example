# Cadena de conexión a PostgreSQL 16 o superior.
# El usuario debe poder crear tablas, extensiones (btree_gist) y el rol tempo_app.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tempo_dev

# Base usada solo por las pruebas de integración y de extremo a extremo. Se borra y recrea en cada ejecución.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tempo_test

# Contraseña del usuario de demostración que crea `npm run db:seed`. Obligatoria para sembrar la demo.
DEMO_PASSWORD=

# --- Opcionales -------------------------------------------------------------------------

# Conexión directa para migraciones y siembra, cuando DATABASE_URL pasa por un agrupador de
# conexiones. La integración de Neon en Vercel la define sola.
# DATABASE_URL_UNPOOLED=

# Conexiones máximas por instancia del servidor (10 si no se define).
# DATABASE_POOL_MAX=

# Pon "false" para impedir que se registren empresas nuevas en una instalación pública.
# REGISTRO_ABIERTO=true
